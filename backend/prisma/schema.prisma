generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

model Usuario {
  id                String    @id @default(uuid())
  nome              String
  email             String    @unique
  senha             String
  role              Role      @default(ALUNO)
  professorId       String?
  professor         Usuario?  @relation("ProfessorAluno", fields: [professorId], references: [id])
  alunos            Usuario[] @relation("ProfessorAluno")
  treinos           Treino[]
  anamnese          Anamnese?
  faturas           Fatura[]
  agendasProfessor  Agenda[]  @relation("AgendaProfessor")
  agendasAluno      Agenda[]  @relation("AgendaAluno")
  convitesEnviados  Convite[] @relation("ProfessorConvites")
  telefone          String?
  fotoUrl           String?
  whatsapp          String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  faixa         String?
  mpAccessToken String?
  aulasCriadas   AulaGravada[] @relation("ProfessorAula")
  aulasCompradas AcessoAula[]  @relation("AlunoAcesso")
  pacotesCriados Pacote[]     @relation("ProfessorPacote")
  pacotesComprados AcessoPacote[] @relation("AlunoPacote")
}

model Exercicio {
  id            String       @id @default(uuid())
  nome          String       @unique
  grupoMuscular String
  descricao     String?
  equipamento   String?
  nivel         String?
  categoria     String?
  gifUrl        String?      // legado - manter compat
  gifInicioUrl  String?
  gifFimUrl     String?
  ativo         Boolean      @default(true)
  itensTreino   ItemTreino[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Treino {
  id          String       @id @default(uuid())
  nome        String
  descricao   String?
  alunoId     String?      // opcional - null = template pré-montado
  aluno       Usuario?     @relation(fields: [alunoId], references: [id])
  professorId String?      // quem criou
  isTemplate  Boolean      @default(false)
  itens       ItemTreino[]
  createdAt   DateTime     @default(now())
}

model ItemTreino {
  id          String    @id @default(uuid())
  treinoId    String
  exercicioId String
  series      Int
  repeticoes  String
  descansoSeg Int
  observacoes String?
  treino      Treino    @relation(fields: [treinoId], references: [id])
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
}

model Anamnese {
  id        String   @id @default(uuid())
  alunoId   String   @unique
  aluno     Usuario  @relation(fields: [alunoId], references: [id])
  respostas Json
  createdAt DateTime @default(now())
}

model Fatura {
  id            String   @id @default(uuid())
  alunoId       String
  aluno         Usuario  @relation(fields: [alunoId], references: [id])
  mercadoPagoId String?  @unique
  valor         Float
  plano         String
  status        String
  createdAt     DateTime @default(now())
}

model Agenda {
  id          String   @id @default(uuid())
  professorId String
  alunoId     String?
  titulo      String
  tipo        String   // AVALIACAO, CONSULTORIA, TREINO
  data        DateTime
  duracaoMin  Int      @default(60)
  status      String   @default("AGENDADO") // AGENDADO, CONCLUIDO, CANCELADO
  professor   Usuario  @relation("AgendaProfessor", fields: [professorId], references: [id])
  aluno       Usuario? @relation("AgendaAluno", fields: [alunoId], references: [id])
  createdAt   DateTime @default(now())
}

model Convite {
  id          String   @id @default(uuid())
  professorId String
  alunoEmail  String
  alunoId     String?
  token       String   @unique
  status      String   @default("PENDENTE")
  expiresAt   DateTime
  professor   Usuario  @relation("ProfessorConvites", fields: [professorId], references: [id])
  createdAt   DateTime @default(now())
}

model AulaGravada {
  id          String       @id @default(uuid())
  titulo      String
  descricao   String?
  embedUrl    String
  preco       Float
  faixaMinima String?
  categoria   String       @default("MUSCULACAO") // MUSCULACAO, LUTAS_JIU_JITSU, LUTAS_MUAY_THAI, LUTAS_TAEKWONDO, LUTAS_BOXE
  gratuita    Boolean      @default(false) // true = demonstração na prateleira gratuita
  secao       String?      // organização do professor (ex: "Fundamentos") — visível só no catálogo dele
  ordem       Int          @default(0) // ordem dentro da seção no catálogo do professor
  professorId String
  professor   Usuario      @relation("ProfessorAula", fields: [professorId], references: [id])
  acessos     AcessoAula[]
  emPacotes   ItemPacote[]
  createdAt   DateTime     @default(now())
}

// Pacote do professor (ex: "Boxe Fundamentos") — só ele e os alunos dele veem
model Pacote {
  id          String       @id @default(uuid())
  titulo      String
  descricao   String?
  preco       Float
  categoria   String       @default("MUSCULACAO")
  professorId String
  professor   Usuario      @relation("ProfessorPacote", fields: [professorId], references: [id])
  itens       ItemPacote[]
  acessos     AcessoPacote[]
  createdAt   DateTime     @default(now())
}

model ItemPacote {
  id        String      @id @default(uuid())
  pacoteId  String
  aulaId    String
  ordem     Int         @default(0)
  pacote    Pacote      @relation(fields: [pacoteId], references: [id], onDelete: Cascade)
  aula      AulaGravada @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  @@unique([pacoteId, aulaId])
}

model AcessoPacote {
  id        String   @id @default(uuid())
  alunoId   String
  pacoteId  String
  aluno     Usuario  @relation("AlunoPacote", fields: [alunoId], references: [id])
  pacote    Pacote   @relation(fields: [pacoteId], references: [id])
  status    String   @default("PENDENTE") // PENDENTE, LIBERADO, REVOGADO
  expiresAt DateTime?
  createdAt DateTime @default(now())
  @@unique([alunoId, pacoteId])
}
model AcessoAula {
  id        String      @id @default(uuid())
  alunoId   String
  aulaId    String
  aluno     Usuario     @relation("AlunoAcesso", fields: [alunoId], references: [id])
  aula      AulaGravada @relation(fields: [aulaId], references: [id])
  status    String      @default("PENDENTE")
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  @@unique([alunoId, aulaId])
}